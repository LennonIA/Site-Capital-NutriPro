{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/admin.js": { "includeFiles": "admin/**" },
    "api/content.js": { "includeFiles": "public/{insights/**,404.html}" }
  },
  "redirects": [
    { "source": "/insights/artigo.html", "destination": "/insights/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin?route=page" },
    { "source": "/api/admin/leads.csv", "destination": "/api/admin?route=csv" },
    { "source": "/api/admin/leads/:id", "destination": "/api/admin?route=update&id=:id" },
    { "source": "/api/admin/leads", "destination": "/api/admin?route=list" },
    { "source": "/insights/:slug([a-z0-9-]+)", "destination": "/api/content?type=article&slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/content?type=sitemap" },
    { "source": "/robots.txt", "destination": "/api/content?type=robots" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
